# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Build outputs (PyInstaller)
/build/
/dist/
!frontend/dist/
*.spec
*.msi
*.exe

# Installer outputs (keep the folder but ignore executables and temp files)
installer/*.exe
installer/*.log
installer/*.tmp

# IDE/editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Local config / secrets
*.env
.env*

# PyInstaller / Inno Setup artifacts
*.toc
*.pyz
*.manifest
